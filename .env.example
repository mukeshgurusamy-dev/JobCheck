# Template for local development. Copy to `.env` and fill in real values.
# NEVER commit the real `.env` — it is listed in .gitignore.
#
# On Netlify, set these in Site Settings > Environment Variables instead of
# committing a `.env` file.

# Required for the AI intelligence layer (Google Gemini, search grounding).
GEMINI_API_KEY=

# Alternative name accepted by netlify/functions/aiSearch.ts if GEMINI_API_KEY
# is not set.
GOOGLE_API_KEY=

# Optional. Enables the Google Safe Browsing rule (+60 risk points).
SAFE_BROWSING_KEY=
